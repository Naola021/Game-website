---
// src/pages/projects/[slug].astro
import PageLayout from '~/layouts/PageLayout.astro';
import { projects } from '~/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const metadata = {
  title: `${project.title} — [Your Gaming Company]`,
};
---

<PageLayout metadata={metadata}>
  <section class="section">
    <div class="back-link">
      <a href="/projects">← Back to Projects</a>
    </div>
    <div class="title-row">
      <h1>{project.title}</h1>
      <p class="client">{project.client}</p>
    </div>

    {
      project.images && project.images.length > 0 ? (
        <div class="gallery" aria-label={`${project.title} screenshots`}>
          <button class="gallery-arrow gallery-arrow-left" id="galleryPrev" aria-label="Previous screenshot">
            &#8249;
          </button>
          <div class="gallery-track" id="galleryTrack">
            {project.images.map((src: string, i: number) => (
              <img src={src} alt={`${project.title} screenshot ${i + 1}`} class="gallery-item" loading="lazy" />
            ))}
          </div>
          <button class="gallery-arrow gallery-arrow-right" id="galleryNext" aria-label="Next screenshot">
            &#8250;
          </button>
        </div>
      ) : (
        <div class="gallery gallery-empty">
          <span class="gallery-placeholder">[Project screenshots — click to enlarge]</span>
        </div>
      )
    }

    <div class="info-row">
      <div class="info-box">
        <h3>Client</h3>
        <p>{project.client}</p>
      </div>
      <div class="info-box">
        <h3>Tech Stack</h3>
        <div class="tags">
          {project.techStack.map((t: string) => <span class="tag">{t}</span>)}
        </div>
      </div>
    </div>

    <div class="main-col">
      <h2>Scope of Work</h2>
      <p class="description">{project.scope}</p>

      <h2>Outcome</h2>
      <p class="description">{project.outcome}</p>
    </div>
  </section>
</PageLayout>

<style>
  .section {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .title-row {
    margin-bottom: 1.5rem;
  }
  .title-row h1 {
    font-size: 2rem;
    color: var(--text-dark);
    margin-bottom: 0.4rem;
  }
  .client {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .info-row {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 0.75rem;
  }
  .info-row .info-box {
    flex: 1 1 220px;
  }

  .gallery {
    position: relative;
    margin-bottom: 2rem;
  }
  .gallery-empty {
    background: var(--surface-alt);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .gallery-empty:hover {
    border-color: var(--brand-purple);
  }
  .gallery-placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: 10px;
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-item {
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    scroll-snap-align: start;
    background: var(--surface-alt);
  }
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: rgba(20, 8, 40, 0.65);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .gallery-arrow:hover {
    background: var(--brand-purple);
    border-color: var(--brand-purple);
  }
  .gallery-arrow-left {
    left: 10px;
  }
  .gallery-arrow-right {
    right: 10px;
  }
  @media (max-width: 768px) {
    .gallery-arrow {
      display: none;
    }
  }

  h2 {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.75rem;
  }
  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .back-link {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .back-link:hover {
    color: var(--brand-purple);
  }
  .info-box {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.1rem;
  }
  .info-box h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .info-box p {
    font-size: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.78rem;
    color: var(--brand-purple);
    background: var(--brand-purple-light);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  @media (max-width: 768px) {
    .info-row {
      flex-direction: column;
    }
  }
</style>

<script>
  const track = document.getElementById('galleryTrack');
  const prevBtn = document.getElementById('galleryPrev');
  const nextBtn = document.getElementById('galleryNext');

  function scrollByOneItem(direction: number) {
    if (!track) return;
    track.scrollBy({ left: track.clientWidth * direction, behavior: 'smooth' });
  }

  prevBtn?.addEventListener('click', () => scrollByOneItem(-1));
  nextBtn?.addEventListener('click', () => scrollByOneItem(1));
</script>