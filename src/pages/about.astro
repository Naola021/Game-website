---
// src/pages/about.astro
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us — FMS IT Solution PLC',
  description:
    'FMS IT Solution PLC is a game development studio dedicated to crafting engaging interactive experiences for mobile, PC, and web.',
};

const team = [
  {
    name: 'Dawit Bekele',
    role: 'Creative Director',
    photo: '/dawit.png',
    bio: 'Directing studio artistic vision, worldbuilding, and immersive player experience design.',
  },
  {
    name: 'Hana Tesfaye',
    role: 'Lead Game Developer',
    photo: '/hana.png',
    bio: 'Spearheading core gameplay engineering, physics systems, and multi-platform engine optimization.',
  },
  {
    name: 'Yohannes Alemu',
    role: 'Game Designer',
    photo: '/yohannes.png',
    bio: 'Designing responsive mechanics, rewarding progression loops, and balanced economies.',
  },
  {
    name: 'Samuel Girma',
    role: 'Narrative Designer',
    photo: '/samuel.png',
    bio: 'Crafting captivating game narratives, character arcs, quest structures, and lore.',
  },
];

const pillars = [
  {
    title: 'Player-Centered Craft',
    description:
      'We obsess over game feel, tactile feedback, and intuitive controls that make gameplay immediately satisfying.',
  },
  {
    title: 'Technical Discipline',
    description:
      'Hands-on production across industry-standard game engines and WebGL with comprehensive multi-platform deployment knowledge.',
  },
  {
    title: 'Transparent Collaboration',
    description: 'Predictable milestone checkpoints and playable builds keep production aligned and on schedule.',
  },
  {
    title: 'Full IP Ownership',
    description:
      'Our clients retain 100% ownership of source code, 3D assets, project repositories, and intellectual property.',
  },
];
---

<PageLayout metadata={metadata}>
  <!-- Grand Hero Banner with Specular White Gradient Ending Edge -->
  <section
    class="hero-grand-canvas pt-28 pb-16 sm:pt-36 sm:pb-24 rounded-b-[2.5rem] sm:rounded-b-[4rem] text-white relative z-20"
  >
    <div class="flute-overlay"></div>

    <!-- Specular White Gradient Ending Edge -->
    <div class="hero-white-edge"></div>
    <div class="hero-white-glow"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
      <!-- Sleek Black Badge -->
      <div
        class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-black/60 border border-white/20 text-white/90 backdrop-blur-md mb-6 shadow-xs"
      >
        <span>Game Development Studio</span>
      </div>

      <!-- Architectural Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-white leading-[1.05]">
        The Team Behind<br />
        <span class="bg-gradient-to-r from-emerald-400 via-emerald-300 to-[#0CDAFC] bg-clip-text text-transparent"
          >The Games</span
        >
      </h1>

      <p class="mt-5 text-sm sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        FMS IT Solution PLC brings together passionate developers, 3D artists, and game designers to build high-quality
        games players love.
      </p>
    </div>
  </section>

  <!-- Editorial Story Section -->
  <section class="py-16 sm:py-24 relative z-10 bg-white dark:bg-[#060c08]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left: Story Narrative -->
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 block">
            Our Mission
          </span>
          <h2
            class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tight leading-tight"
          >
            Crafting Memorable Games with Technical Precision
          </h2>
          <div class="space-y-3.5 text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed pt-1">
            <p>
              FMS IT Solution PLC was founded on the belief that standout games emerge when artistic vision meets
              disciplined engineering.
            </p>
            <p>
              Whether creating original titles or collaborating with visionary creators to bring ambitious worlds to
              life, our team is committed to delivering memorable player experiences with zero compromise on
              performance.
            </p>
          </div>
        </div>

        <!-- Right: Studio Values Card (Dark Glassmorphic) -->
        <div class="lg:col-span-6">
          <div class="rounded-3xl bg-[#0a140e] border border-white/[0.09] p-6 sm:p-8 space-y-6 text-white shadow-xl">
            <h3 class="text-lg font-bold text-white uppercase tracking-tight">OUR VALUES</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#0CDAFC] mt-1.5 shrink-0 shadow-[0_0_8px_rgba(12,218,252,0.6)]"
                ></span>
                <div>
                  <h4 class="text-sm font-bold text-white uppercase">Player-First Feel</h4>
                  <p class="text-xs text-slate-300 mt-0.5 leading-relaxed">
                    Prioritizing intuitive controls, rewarding feedback, and smooth frame rates.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#0CDAFC] mt-1.5 shrink-0 shadow-[0_0_8px_rgba(12,218,252,0.6)]"
                ></span>
                <div>
                  <h4 class="text-sm font-bold text-white uppercase">Milestone Clarity</h4>
                  <p class="text-xs text-slate-300 mt-0.5 leading-relaxed">
                    Regular sprint checkpoints with playable builds to keep everyone aligned.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#0CDAFC] mt-1.5 shrink-0 shadow-[0_0_8px_rgba(12,218,252,0.6)]"
                ></span>
                <div>
                  <h4 class="text-sm font-bold text-white uppercase">Modular Code</h4>
                  <p class="text-xs text-slate-300 mt-0.5 leading-relaxed">
                    Clean, scalable architecture engineered for effortless live updates and expansion.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Showcase Section (Light Section Background with High-End Dark Cards) -->
  <section class="py-16 sm:py-24 relative z-10 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block"> Leadership </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 uppercase leading-tight">
          Meet Our Team
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          The core team bringing games from concept to launch.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          team.map((member) => (
            <div class="rounded-3xl bg-[#0d1810] border border-white/[0.08] p-6 text-white flex flex-col items-center text-center group hover:border-[#0CDAFC]/30 transition-all duration-300 shadow-xl">
              {/* Avatar */}
              <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden mb-5 border-2 border-white/10 group-hover:border-[#0CDAFC]/40 transition-colors shadow-md">
                <img
                  src={member.photo}
                  alt={member.name}
                  class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                />
              </div>

              {/* Name */}
              <h3 class="text-base sm:text-lg font-bold text-white uppercase tracking-tight group-hover:text-emerald-400 transition-colors">
                {member.name}
              </h3>

              {/* Role */}
              <span class="text-xs font-bold uppercase tracking-wider text-[#0CDAFC] mt-1 mb-3 block">
                {member.role}
              </span>

              {/* Description / Bio */}
              <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.06] w-full text-center">
                <p class="text-xs text-slate-300 leading-relaxed font-normal">{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Core Pillars Bento -->
  <section class="py-16 sm:py-24 relative z-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block"> OUR STANDARDS </span>
        <h2
          class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white uppercase leading-tight"
        >
          Why Work With Us
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          The foundational principles guiding every project we deliver.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {
          pillars.map((item) => (
            <div class="editorial-card p-6 sm:p-7 flex gap-4 items-start">
              <span class="w-2.5 h-2.5 rounded-full bg-[#0CDAFC] mt-2 shrink-0 shadow-[0_0_8px_rgba(12,218,252,0.6)]" />
              <div class="space-y-1">
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white uppercase tracking-tight">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing Studio Banner -->
  <section
    class="py-14 sm:py-20 relative z-10 bg-slate-50 dark:bg-[#09120c] border-t border-slate-200/80 dark:border-white/[0.06]"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-5">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 block">
        Start A Conversation
      </span>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white uppercase tracking-tight">
        Have a game idea?<br />Let's bring it to life.
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Let’s bring your game vision to life
      </p>
      <div class="pt-3">
        <a href="/contact" class="btn-pill-emerald text-sm px-8 py-4">
          <span>LET'S GET IN TOUCH →</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>
