---

import PageLayout from '~/layouts/PageLayout.astro';
import { products } from '~/data/products';

const metadata = {
  title: 'Cart — ~DemoGames',
};
---

<PageLayout metadata={metadata}>
  <section class="page-hero">
    <h1>Your Cart</h1>
  </section>

  <section class="section">
    <div id="cartEmpty" class="empty-state" hidden>
      <div class="empty-icon">🛒</div>
      <h2>Your cart is empty</h2>
      <p>Looks like you haven't added anything yet.</p>
      <a href="/products" class="btn btn-primary">Browse Games</a>
    </div>

    <div id="cartContent" class="cart-layout" hidden>
      <div class="cart-items" id="cartItems"></div>

      <aside class="order-summary">
        <h3>Order Summary</h3>
        <div class="summary-row">
          <span>Subtotal</span>
          <span id="cartSubtotal">$0.00</span>
        </div>
        <div class="summary-row total-row">
          <span>Total</span>
          <span id="cartTotal">$0.00</span>
        </div>
        <button id="checkoutBtn" class="btn btn-primary btn-block">Checkout</button>
        <p class="demo-note">payment will be processed.</p>
      </aside>
    </div>

    <div id="checkoutSuccess" class="empty-state" hidden>
      <div class="empty-icon">✅</div>
      <h2>Order placed!</h2>
      <p>Thanks for your demo order — this is a portfolio project, so no real payment was taken and no game will be delivered.</p>
      <a href="/products" class="btn btn-primary">Continue Browsing</a>
    </div>
  </section>
</PageLayout>

<script define:vars={{ products }}>
  const cartEmpty = document.getElementById('cartEmpty');
  const cartContent = document.getElementById('cartContent');
  const cartItemsEl = document.getElementById('cartItems');
  const cartSubtotalEl = document.getElementById('cartSubtotal');
  const cartTotalEl = document.getElementById('cartTotal');
  const checkoutBtn = document.getElementById('checkoutBtn');
  const checkoutSuccess = document.getElementById('checkoutSuccess');

  function getCart() {
    return JSON.parse(localStorage.getItem('demo_cart') || '[]');
  }
  function setCart(list) {
    localStorage.setItem('demo_cart', JSON.stringify(list));
    window.dispatchEvent(new Event('storage'));
  }
  function priceToNumber(price) {
    if (!price) return 0;
    return parseFloat(String(price).replace(/[^0-9.]/g, '')) || 0;
  }

  function render() {
    const cart = getCart();
    const items = cart.map((slug) => products.find((p) => p.slug === slug)).filter(Boolean);

    if (items.length === 0) {
      cartEmpty.hidden = false;
      cartContent.hidden = true;
      return;
    }

    cartEmpty.hidden = true;
    cartContent.hidden = false;

    cartItemsEl.innerHTML = items
      .map(
        (p) => `
      <div class="cart-item" data-slug="${p.slug}">
        <img src="${p.images?.[0] || ''}" alt="${p.title}" class="cart-item-img" />
        <div class="cart-item-info">
          <h3>${p.title}</h3>
          <span class="cart-item-platform">${p.platform}</span>
        </div>
        <span class="cart-item-price">${p.price || 'Free'}</span>
        <button class="remove-btn" data-slug="${p.slug}" aria-label="Remove">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z"/></svg>
        </button>
      </div>
    `,
      )
      .join('');

    const subtotal = items.reduce((sum, p) => sum + priceToNumber(p.price), 0);
    cartSubtotalEl.textContent = `$${subtotal.toFixed(2)}`;
    cartTotalEl.textContent = `$${subtotal.toFixed(2)}`;

    cartItemsEl.querySelectorAll('.remove-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        setCart(getCart().filter((s) => s !== btn.dataset.slug));
        render();
      });
    });
  }

  checkoutBtn?.addEventListener('click', () => {
    setCart([]);
    cartContent.hidden = true;
    checkoutSuccess.hidden = false;
  });

  render();
</script>

<style>
  .page-hero {
    background:  rgb(60, 3, 94);
    color: #fff;
    text-align: center;
    padding: 3.5rem 1.5rem;
  }
  .page-hero h1 {
    color: #fff;
    font-size: 2rem;
  }

  .section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .empty-state h2 {
    margin-bottom: 0.5rem;
  }
  .empty-state p {
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cart-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 0.85rem;
    background: var(--surface-alt);
  }
  .cart-item-img {
    width: 120px;
    height: 68px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .cart-item-info {
    flex: 1;
    min-width: 0;
  }
  .cart-item-info h3 {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }
  .cart-item-platform {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .cart-item-price {
    font-weight: 700;
    color: var(--text-dark);
    white-space: nowrap;
  }
  .remove-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .remove-btn svg {
    width: 18px;
    height: 18px;
  }
  .remove-btn:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
  }

  .order-summary {
    position: sticky;
    top: 90px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.5rem;
    background: var(--surface-alt);
  }
  .order-summary h3 {
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }
  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .total-row {
    color: var(--text-dark);
    font-weight: 700;
    font-size: 1.1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
    margin-top: 0.5rem;
  }
  .btn-block {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: 1.25rem;
  }
  .btn-primary {
    background: var(--brand-purple);
    color: #fff;
    border: none;
    padding: 0.85rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-primary:hover {
    background: var(--brand-purple-dark);
  }
  .demo-note {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-top: 0.85rem;
  }

  @media (max-width: 768px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }
    .order-summary {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .cart-item {
      flex-wrap: wrap;
    }
  }
</style>