---

import PageLayout from '~/layouts/PageLayout.astro';
import { products } from '~/data/products';

const metadata = {
  title: 'Products — ~DemoGames',
};


---

<PageLayout metadata={metadata}>
  <div class="page-gradient">
  <section class="page-hero">
    <h1>Products</h1>
  </section>

  <section class="section">
    

    <div class="card-grid">
      {
        products.map((game) => (
          <a href={`/products/${game.slug}`} class="card">
            <div class="card-thumb">
              {game.images?.[0] && <img src={game.images[0]} alt={game.title} class="card-img" />}
              <span class="card-overlay">Learn More</span>
            </div>
            <h3>{game.title}</h3>
            <span class="badge">{game.platform}</span>
          </a>
        ))
      }
    </div>
  </section>
  </div>
</PageLayout>

<style>
.page-gradient {
    background: var(--page-gradient);
  }
  .page-hero {
    background-image: url('/products.png');
    /* background */
    height: 250px;

      color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
    
  }
  
  .page-hero h1 {
    color: #fff;
    font-size: 3rem;
    font-weight: 900;
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .filters {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .filter-chip {
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-dark);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .filter-chip:hover {
    border-color: var(--brand-purple);
    color: var(--brand-purple);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .card {
    border: 1px solid rgba(58, 6, 88, 0.137);
    border-radius: 10px;
    padding: 1rem;
    display: block;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(124, 58, 237, 0.15);
    border-color: var(--brand-purple);
  }
  .card-thumb {
    position: relative;
    background: var(--brand-purple-light);
    height: 160px;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-overlay {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: rgba(20, 8, 40, 0.55);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .card:hover .card-overlay {
    opacity: 1;
  }
  .card h3 {
    font-size: 1rem;
    color: var(--text-dark);
    margin-bottom: 0.4rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--brand-purple);
    background: var(--brand-purple-light);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>