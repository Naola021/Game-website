---

import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Privacy Policy — ~DemoGames',
};

const lastUpdated = 'August 2026';
---

<PageLayout metadata={metadata}>
  <section class="page-hero">
    <h1>Privacy Policy</h1>
    <p class="updated">Last updated: {lastUpdated}</p>
  </section>

  <section class="section">
    <div class="legal-content">
      <p class="intro">
        This Privacy Policy explains how DemoGames collects,
        uses, and protects information when you visit this website. This is a demo/portfolio
        project — no real personal data is processed, stored on a server, or shared with third
        parties.
      </p>

      <h2>1. Information We Collect</h2>
      <p>
        This site may collect limited information you voluntarily provide, such as your name,
        email address, and message when using the Contact form. Cart and Wishlist selections are
        stored only in your browser's local storage and are never sent to or stored on a server.
      </p>

      <h2>2. How We Use Information</h2>
      <p>
        Any information submitted through the Contact form is used solely to respond to your
        inquiry. We do not sell, rent, or share this information with third parties.
      </p>

      <h2>3. Cookies &amp; Local Storage</h2>
      <p>
        This site uses your browser's local storage to remember items you add to your Cart or
        Wishlist. This data stays on your device and is not accessible to us. No tracking cookies
        or third-party advertising scripts are used on this site.
      </p>

      <h2>4. Third-Party Services</h2>
      <p>
        The Contact form on this site may use a third-party form service (e.g. Formspree) to
        deliver messages by email. Please refer to that provider's own privacy policy for details
        on how they handle submitted data.
      </p>

      <h2>5. Data Security</h2>
      <p>
        We take reasonable measures to protect any information submitted through this site.
        However, no method of transmission over the internet is 100% secure.
      </p>

      <h2>6. Children's Privacy</h2>
      <p>
        This site is not directed at children under 13, and we do not knowingly collect personal
        information from children.
      </p>

      <h2>7. Changes to This Policy</h2>
      <p>
        We may update this Privacy Policy from time to time. Changes will be posted on this page
        with an updated "Last updated" date.
      </p>

      <h2>8. Contact Us</h2>
      <p>
        If you have questions about this Privacy Policy, please reach out via the
        <a href="/contact">Contact page</a>.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--brand-purple-dark), var(--brand-purple-darker));
    color: #fff;
    text-align: center;
    padding: 3.5rem 1.5rem;
  }
  .page-hero h1 {
    color: #fff;
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .updated {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
  }

  .section {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .legal-content .intro {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .legal-content h2 {
    font-size: 1.1rem;
    color: var(--text-dark);
    margin: 2rem 0 0.75rem;
  }
  .legal-content h2:first-of-type {
    margin-top: 0;
  }

  .legal-content p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .legal-content a {
    color: var(--brand-purple);
    text-decoration: underline;
  }
  .legal-content a:hover {
    color: var(--brand-purple-dark);
  }
</style>