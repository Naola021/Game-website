---
// src/pages/privacy.astro
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Privacy Policy | FMS IT Solution PLC',
  description: 'Privacy policy for FMS IT Solution PLC website and services.',
};

const lastUpdated = 'August 2026';
---

<PageLayout metadata={metadata}>
  <section class="pt-8 pb-10 sm:pt-12 sm:pb-14 text-center relative z-10">
    <div class="max-w-3xl mx-auto px-4 space-y-3">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300">
        <span>Legal Documentation</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Privacy Policy
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="pb-16 sm:pb-24 relative z-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="glass-card p-6 sm:p-10 space-y-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        <p class="text-base text-slate-700 dark:text-slate-200 border-b border-slate-200/80 dark:border-white/[0.08] pb-4">
          This Privacy Policy explains how FMS IT Solution PLC collects, uses, and safeguards information when you visit our website or contact our game studio.
        </p>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">1. Information We Collect</h2>
          <p>
            When you submit an inquiry through our contact form, we collect the details you voluntarily provide: your name, email address, project topic, and message.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">2. How We Use Your Information</h2>
          <p>
            Information submitted is used exclusively to evaluate project feasibility and respond to your communication. We never sell, lease, or share your contact information with external parties.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">3. Data Security & Confidentiality</h2>
          <p>
            We adhere to strict data security standards and client confidentiality practices. Project concepts, storylines, and proprietary mechanics shared with us remain strictly confidential.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">4. Contact Us</h2>
          <p>
            If you have questions regarding this Privacy Policy, please reach out via our <a href="/contact" class="text-emerald-600 dark:text-emerald-400 underline font-medium hover:text-emerald-500">Contact page</a> or email <a href="mailto:ceo@fms.et" class="text-emerald-600 dark:text-emerald-400 underline font-medium hover:text-emerald-500">ceo@fms.et</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>