---

import PageLayout from '~/layouts/PageLayout.astro';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Projects — [Your Gaming Company]',
};
---

<PageLayout metadata={metadata}>
  <div class="page-gradient">
  <section class="page-hero">
    <h1>Projects</h1>
  </section>

  <section class="section">
    <div class="card-grid">
      {
        projects.map((p) => (
          <a href={`/projects/${p.slug}`} class="card">
            <div class="card-thumb">
              {p.images?.[0] ? <img src={p.images[0]} alt={p.title} /> : null}
              <span class="card-overlay">View Case Study</span>
            </div>
            <h3>{p.title}</h3>
            <p class="client">{p.client}</p>
          </a>
        ))
      }
    </div>
  </section>
  </div>
</PageLayout>

<style>
  
  .page-hero {
    background-image: url('/projects2.png');
    /* background: linear-gradient(135deg, var(--brand-purple-dark), var(--brand-purple-darker)); */
    height: 270px;

      color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
    
  }
  .page-hero h1 {
    color:  rgba(0, 0, 0, 0);
    -webkit-text-stroke-width: 0.6px;
  -webkit-text-stroke-color: rgb(11, 8, 14);
    font-size: 3rem;
   
    font-weight: 900;
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .card {
   border: 1px solid rgba(61, 3, 94, 0.137);
    border-radius: 10px;
    padding: 1rem;
    display: block;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(124, 58, 237, 0.15);
    border-color: var(--brand-purple);
  }
  .card-thumb {
    position: relative;
    background: var(--brand-purple-light);
    height: 220px;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.15s ease;
  }
  .card:hover .card-thumb img {
    filter: brightness(0.5);
  }
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .card:hover .card-overlay {
    opacity: 1;
  }
  .card h3 {
    font-size: 1.05rem;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }
  .client {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>