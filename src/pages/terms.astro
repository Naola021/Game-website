---
// src/pages/terms.astro
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Terms of Service | FMS IT Solution PLC',
  description: 'Terms of service for FMS IT Solution PLC website and engagement.',
};

const lastUpdated = 'August 2026';
---

<PageLayout metadata={metadata}>
  <section class="pt-8 pb-10 sm:pt-12 sm:pb-14 text-center relative z-10">
    <div class="max-w-3xl mx-auto px-4 space-y-3">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full text-xs font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300">
        <span>Legal Documentation</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
        Terms of Service
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="pb-16 sm:pb-24 relative z-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="glass-card p-6 sm:p-10 space-y-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        <p class="text-base text-slate-700 dark:text-slate-200 border-b border-slate-200/80 dark:border-white/[0.08] pb-4">
          By accessing or using this website, you agree to be bound by these Terms of Service.
        </p>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">1. Use of Website</h2>
          <p>
            This website provides information about game development services and capabilities offered by FMS IT Solution PLC. You may browse and submit inquiries for legitimate business collaborations.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">2. Intellectual Property</h2>
          <p>
            All original graphics, trademarks, logos, and written content on this website are the property of FMS IT Solution PLC or their respective holders. Commercial production projects follow formal contracts with full client IP transfer upon milestone completion.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">3. Inquiries & Proposals</h2>
          <p>
            Submissions via our contact form represent requests for consultation and preliminary project estimation. Formal development agreements are governed by signed production contracts and scopes of work.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">4. Contact Us</h2>
          <p>
            If you have questions about these Terms, please reach out via our <a href="/contact" class="text-emerald-600 dark:text-emerald-400 underline font-medium hover:text-emerald-500">Contact page</a> or email <a href="mailto:ceo@fms.et" class="text-emerald-600 dark:text-emerald-400 underline font-medium hover:text-emerald-500">ceo@fms.et</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>