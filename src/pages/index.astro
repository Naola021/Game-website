---
// src/pages/index.astro
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'FMS IT Solution PLC — Game Development Studio',
  description:
    'FMS IT Solution PLC is a premier game development studio creating engaging games and interactive digital experiences for mobile, PC, and web browsers.',
};

const coreDisciplines = [
  {
    number: '01',
    title: 'Gameplay Engineering',
    desc: 'Responsive controls, stable performance, and smooth gameplay feel across mobile, PC, and web — engineered so the game plays as good as it looks.',
  },
  {
    number: '02',
    title: '3D Art & Animation',
    desc: 'Bespoke character modeling, rigging, procedural texturing, stylized environments, and custom compute shaders and VFX.',
  },
  {
    number: '03',
    title: 'Economy & Level Balancing',
    desc: 'Data-informed progression loops, difficulty curves, reward economies, and replayable level design that drives player retention.',
  },
  {
    number: '04',
    title: 'Multi-Store Deployment',
    desc: 'Store submission, platform compliance, and ongoing support across the platforms your players are on.',
  },
];

const capabilities = [
  {
    number: '01',
    title: 'GAMEPLAY ENGINEERING & ARCHITECTURE',
    desc: 'High-performance cross-platform engineering with responsive physics, stable networking, and modular game architectures.',
    tag: 'Engineering',
  },
  {
    number: '02',
    title: '3D CHARACTER ART, RIGGING & VFX',
    desc: 'End-to-end visual art pipeline: from concept illustration and high-poly sculpting to skeletal rigging, blend shapes, and particle effects.',
    tag: 'Art & Animation',
  },
  {
    number: '03',
    title: 'ECONOMY BALANCING & GAME SYSTEMS',
    desc: 'Designing sustainable in-game economies, battle pass structures, balanced reward trees, and intuitive player onboarding journeys.',
    tag: 'System Design',
  },
  {
    number: '04',
    title: 'MULTI-STORE PUBLISHING & LIVE OPS',
    desc: 'Store certification management, crash telemetry tracking, live event orchestration, and scheduled content update deployments.',
    tag: 'Publishing',
  },
];

const faqs = [
  {
    question: 'What types of game projects does FMS IT Solution develop?',
    answer:
      'We develop full-cycle 2D and 3D games across mobile, PC, and instant WebGL browser formats — encompassing action, adventure, puzzle, arcade, strategy, and narrative simulation genres.',
  },
  {
    question: 'What is your typical production timeline?',
    answer:
      'Timelines vary by scope: focused playable graybox prototypes are typically delivered in 2 to 4 weeks, while full-scale multi-platform productions span 2 to 6 months, with playable builds delivered at each milestone.',
  },
  {
    question: 'How do you structure milestones and project updates?',
    answer:
      'We work in transparent agile sprints, delivering playable builds at each milestone. Every milestone has clear acceptance criteria, testable deliverables, and a full sprint review.',
  },
  {
    question: 'Do we retain full ownership of the game assets and source code?',
    answer:
      'Yes, 100%. All source code, 3D models, animations, shaders, documentation, and repository access are fully transferred to you upon completion.',
  },
];
---

<PageLayout metadata={metadata}>
  <!-- Hero Section: Grand Curved Canvas with Specular White Gradient Ending Edge -->
  <section
    class="hero-grand-canvas pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-44 lg:pb-36 rounded-b-[2.5rem] sm:rounded-b-[4rem] text-white relative z-20"
  >
    <div class="flute-overlay"></div>

    <!-- Specular White Gradient Ending Edge Overlays -->
    <div class="hero-white-edge"></div>
    <div class="hero-white-glow"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
      <!-- Sleek Black Badge -->
      <div
        class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-black/60 border border-white/20 text-white/90 backdrop-blur-md mb-6 sm:mb-8 shadow-xs"
      >
        <span>Game Development Studio</span>
      </div>

      <!-- Architectural Hero Headline -->
      <h1
        class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase tracking-tight text-white leading-[1.02] max-w-5xl"
      >
        DESIGN. DEVELOP.<br />
        <span class="bg-gradient-to-r from-emerald-400 via-emerald-300 to-[#0CDAFC] bg-clip-text text-transparent"
          >DELIVER.</span
        >
      </h1>

      <!-- Subtitle -->
      <p
        class="mt-5 sm:mt-7 text-sm sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal"
      >
        From initial gameplay concept to multi-platform launch — we engineer immersive, high-retention games across
        mobile, PC, and web.
      </p>

      <!-- Dual Action Buttons -->
      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <a href="/contact" class="btn-pill-emerald text-xs tracking-wider uppercase px-8 py-4 w-full sm:w-auto">
          <span>LET'S GET IN TOUCH →</span>
        </a>
        <a
          href="/services"
          class="btn-pill-dark bg-[#080d0a] hover:bg-black border border-white/20 text-white font-semibold text-xs tracking-wider uppercase px-8 py-4 w-full sm:w-auto shadow-xl"
        >
          <span>EXPLORE SERVICES</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Transition Section Below Hero (Light/Clean Background with Distinct Rhythm) -->
  <section class="py-16 sm:py-24 relative z-10 bg-gradient-to-b from-slate-100 via-white to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Intro -->
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block"> Core Focus Areas </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 uppercase tracking-tight leading-tight">
          Built for High Performance & Engagement
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Focused game creation designed to make gameplay feel great and help your project grow.
        </p>
      </div>

      <!-- 4 Core Disciplines Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          coreDisciplines.map((item) => (
            <div class="editorial-card p-6 sm:p-7 flex flex-col justify-between group">
              <div class="space-y-3">
                <span class="text-xs font-mono font-bold text-emerald-600 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20 inline-block group-hover:border-[#0CDAFC]/40 group-hover:text-[#0684D9] transition-colors">
                  {item.number}
                </span>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Editorial About Section: Our Approach -->
  <section class="py-16 sm:py-24 relative z-10 bg-white border-t border-slate-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left: Story Narrative -->
        <div class="lg:col-span-6 space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block"> OUR APPROACH </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 uppercase tracking-tight leading-tight">
            Turning Bold Game Ideas Into Playable Reality
          </h2>
          <div class="space-y-3.5 text-slate-600 text-sm sm:text-base leading-relaxed">
            <p>
              At FMS IT Solution PLC, we believe the best games combine creative ideas with strong technical skills.
            </p>
            <p>
              We work as your full-service game design partner—taking your idea from early prototype concepts through
              production, store release, and post-launch updates.
            </p>
          </div>
          <div class="pt-2">
            <a href="/about" class="btn-pill-dark">
              <span>LEARN MORE ABOUT US →</span>
            </a>
          </div>
        </div>

        <!-- Right: 2 Light Editorial Highlight Cards -->
        <div class="lg:col-span-6 space-y-4">
          <div class="editorial-card p-6 sm:p-7 space-y-2 group">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1 font-mono text-xs">
                <span class="font-bold text-emerald-600">01</span>
                <span class="text-[#0684D9] font-medium text-[11px]">// MILESTONE-DRIVEN</span>
              </div>
              <span class="text-[10px] font-mono text-slate-500 uppercase">Milestone-Based</span>
            </div>
            <h3
              class="text-base sm:text-lg font-bold text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors"
            >
              Playable Milestone Sprints
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We deliver playable builds at each project milestone — so you're validating game feel and progress
              throughout, not just at the end.
            </p>
          </div>

          <div class="editorial-card p-6 sm:p-7 space-y-2 group">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1 font-mono text-xs">
                <span class="font-bold text-emerald-600">02</span>
                <span class="text-[#0684D9] font-medium text-[11px]">// FULL OWNERSHIP</span>
              </div>
              <span class="text-[10px] font-mono text-slate-500 uppercase">100% IP & Code</span>
            </div>
            <h3
              class="text-base sm:text-lg font-bold text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors"
            >
              Complete Asset & Code Transfer
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              You retain full intellectual property rights, source repositories, 3D project files, and engine builds
              from day one.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Split Creative Services Section: Clean Light Theme -->
  <section class="py-16 sm:py-24 relative z-10 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Left Column -->
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-28">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block"> OUR CAPABILITIES </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 uppercase tracking-tight leading-tight">
            Creative<br />Services
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Full-spectrum game development solutions engineered to bring your vision to life across any platform.
          </p>
          <div class="pt-2">
            <a href="/services" class="btn-pill-dark">
              <span>EXPLORE ALL SERVICES ↗</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Capability Cards (Dark Luxury Design) -->
        <div class="lg:col-span-7 space-y-4">
          {
            capabilities.map((cap) => (
              <div class="rounded-2xl sm:rounded-3xl p-6 sm:p-7 bg-[#060c08] border border-white/[0.08] text-white shadow-xl hover:border-[#0CDAFC]/30 transition-all duration-300 space-y-2 group">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-[#0CDAFC]">{cap.number}</span>
                  <span class="text-[11px] font-mono text-slate-400 uppercase group-hover:text-[#0CDAFC] transition-colors">
                    {cap.tag}
                  </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white tracking-tight uppercase group-hover:text-emerald-400 transition-colors">
                  {cap.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">{cap.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Luxury General FAQs Guide Section -->
  <section class="py-16 sm:py-24 relative z-10 bg-white border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-[#060c08] text-white p-8 sm:p-12 lg:p-16 border border-white/[0.08] shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
          <!-- Left Column -->
          <div class="lg:col-span-5 space-y-4">
            <span
              class="text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-emerald-400 to-[#0CDAFC] bg-clip-text text-transparent block"
            >
              Support
            </span>
            <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white leading-tight">
              General FAQs<br />Guide
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
              Find answers to common questions about our capabilities, milestone process, and technology stack.
            </p>
          </div>

          <!-- Right Column: Accordion List -->
          <div class="lg:col-span-7 space-y-3" id="homeFaqAccordion">
            {
              faqs.map((faq, index) => (
                <div class="faq-item border-b border-white/[0.08] pb-3">
                  <button
                    type="button"
                    class="faq-toggle w-full py-4 text-left flex items-center justify-between gap-4 cursor-pointer select-none group"
                    aria-expanded={index === 0 ? 'true' : 'false'}
                  >
                    <span class="text-sm sm:text-base font-semibold text-white group-hover:text-emerald-400 transition-colors">
                      {faq.question}
                    </span>
                    <span class="faq-icon text-lg font-mono text-[#0CDAFC] shrink-0">{index === 0 ? '−' : '+'}</span>
                  </button>
                  <div
                    class:list={[
                      'faq-content text-xs sm:text-sm text-slate-400 leading-relaxed pb-3',
                      index === 0 ? 'block' : 'hidden',
                    ]}
                  >
                    {faq.answer}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing Studio Banner -->
  <section
    class="py-14 sm:py-20 relative z-10 bg-slate-50 dark:bg-[#09120c] border-t border-slate-200/80 dark:border-white/[0.06]"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-5">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 block">
        Start Your Game
      </span>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white uppercase tracking-tight">
        Have a game idea?<br />Let's bring it to life.
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Let’s bring your game vision to life
      </p>
      <div class="pt-3">
        <a href="/contact" class="btn-pill-emerald text-sm px-8 py-4">
          <span>LET'S GET IN TOUCH →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion Script -->
  <script>
    const faqToggles = document.querySelectorAll('#homeFaqAccordion .faq-toggle');

    faqToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const item = toggle.closest('.faq-item');
        const content = item?.querySelector('.faq-content');
        const icon = item?.querySelector('.faq-icon');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        // Close all others
        faqToggles.forEach((t) => {
          const otherItem = t.closest('.faq-item');
          const otherContent = otherItem?.querySelector('.faq-content');
          const otherIcon = otherItem?.querySelector('.faq-icon');
          t.setAttribute('aria-expanded', 'false');
          otherContent?.classList.add('hidden');
          if (otherIcon) otherIcon.textContent = '+';
        });

        if (!isExpanded) {
          toggle.setAttribute('aria-expanded', 'true');
          content?.classList.remove('hidden');
          if (icon) icon.textContent = '−';
        }
      });
    });
  </script>
</PageLayout>
