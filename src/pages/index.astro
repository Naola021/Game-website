---
// src/pages/index.astro
import PageLayout from '~/layouts/PageLayout.astro';
import { products } from '~/data/products';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Demo Games — Crafting Worlds Worth Playing',
};

const featuredProducts = products.slice(0, 3);
const featuredProjects = projects.slice(0, 3);

const services = [
  { icon: '🎮', title: 'Game Development' },
  { icon: '💻', title: 'Web & Interactive' },
  { icon: '🚀', title: 'Game Publishing' },
  { icon: '🤝', title: 'Partnerships' },
];
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <!-- <h1>Crafting Worlds Worth Playing</h1> -->
      <a href="/products" class="btns btn-primary">Play Now</a>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="section">
    <h2 class="section-title">Featured Products</h2>
    <div class="card-grid">
      {
        featuredProducts.map((p) => (
          <a href={`/products/${p.slug}`} class="card">
            <div class="card-thumb">
              {p.images?.[0] ? (
                <img src={p.images[0]} alt={p.title} />
              ) : null}
              <span class="card-overlay">Learn More</span>
            </div>
            <h3>{p.title}</h3>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <h2 class="section-title">Featured Projects</h2>
    <div class="card-grid">
      {
        featuredProjects.map((p) => (
          <a href={`/projects/${p.slug}`} class="card">
            <div class="card-thumb">
              {p.images?.[0] ? <img src={p.images[0]} alt={p.title} /> : null}
              <span class="card-overlay">Learn More</span>
            </div>
            <h3>{p.title}</h3>
          </a>
        ))
      }
    </div>
  </section>

<!-- Services Overview -->
<section class="section services-section">
  <h2 class="section-title">Services Overview</h2>

  <div class="services-row">
    {
      services.map((service) => (
        <a href="/services" class="service-box">
          <span class="service-glyph">{service.icon}</span>
          <span class="service-title">{service.title}</span>
        </a>
      ))
    }
  </div>
</section>
  <!-- Contact Bar -->
  <section class="contact-bar">
    <h2>Let's get in touch?</h2>
    <a href="/contact" class="btne">Contact</a>
  </section>
</PageLayout>

<style>
  .hero {
    background-image: url('/hero-bg.png');
    /* background: linear-gradient(135deg, var(--brand-purple-dark), var(--brand-purple-darker)); */
    height: 530px;

      color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
    
  }
  .hero-content h1 {
    
    color: #fff;
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
  background: radial-gradient(
    circle,
    transparent 55%,
    rgba(0, 0, 0, 0.575) 100%
  );
}

.hero:hover::after {
  opacity: 5;
}
  .btns {
    display: inline-block;
  background:#00000017;
    padding: 12px 32px;
    border-radius: 999px;
    font-weight: 700;
    border: 2px solid #790696;
    font-size: 23px;
    margin-top: 350px;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btns:hover{
  /* color:rgba(59, 9, 105, 0.767); */
    background:#00000063;
    transform: translateY(-2px);
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .section-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: left;
    color: var(--text-dark);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .card {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1rem;
    display: block;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(124, 58, 237, 0.15);
    border-color: var(--brand-purple);
  }
  .card-thumb {
    position: relative;
    background: var(--brand-purple-light);
    height: 140px;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.15s ease;
  }
  .card:hover .card-thumb img {
    filter: brightness(0.55);
  }
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .card:hover .card-overlay {
    opacity: 1;
  }
  .card h3 {
    font-size: 1rem;
    color: var(--text-dark);
  }



.services-section {
  padding-top: 3rem;
  padding-bottom: 3rem;
}

.services-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}

.service-box {
  position: relative;

  min-height: 200px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 0.65rem;

  background:
    linear-gradient(
      145deg,
      rgba(121, 9, 150, 0.13),
      rgba(206, 115, 203, 0.06)
    );

  border: 1px solid rgba(180, 100, 190, 0.2);

  border-radius: 10px;

  text-decoration: none;

  overflow: hidden;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.service-box::before {
  content: "";

  position: absolute;

  width: 80px;
  height: 80px;

  top: -35px;
  right: -25px;

  border-radius: 50%;

  background: rgba(121, 9, 150, 0.18);

  filter: blur(20px);

  transition: opacity 0.2s ease;
}

.service-glyph {
  position: relative;
  z-index: 1;

  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: rgba(121, 9, 150, 0.12);

  border: 1px solid rgba(170, 80, 190, 0.25);

  font-size: 1.6rem;

  filter: drop-shadow(
    0 0 8px rgba(170, 70, 210, 0.45)
  );

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.service-title {
  position: relative;
  z-index: 1;

  color: #d9cde2;

  font-size: 0.85rem;

  font-weight: 600;

  text-align: center;
}

.service-box:hover {
  transform: translateY(-4px);

  border-color: rgba(160, 70, 190, 0.55);

  background:
    linear-gradient(
      145deg,
      rgba(121, 9, 150, 0.23),
      rgba(206, 115, 203, 0.09)
    );

  box-shadow:
    0 10px 30px rgba(90, 20, 120, 0.22);
}

.service-box:hover .service-glyph {
  transform: scale(1.08);

  background: rgba(121, 9, 150, 0.22);
}
 .contact-bar {
  position: relative;
  min-height: 350px;
  height: 300px;
  background-image:
    linear-gradient(
      rgba(10, 6, 18, 0.288),
      rgba(10, 6, 18, 0.24)
    ),
    url('/contactus.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  color: #fff;
  text-align: center;
  padding: 2rem 1.5rem;
  overflow: hidden;
}

/* Slightly soften the image without blurring the text */
.contact-bar::before {
  content: "";
  position: absolute;
  inset: -8px;
  background: inherit;
  filter: blur(1.5px);
  transform: scale(1.02);
  z-index: 0;
}

/* Dark cinematic overlay */
.contact-bar::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(8, 5, 15, 0.45),
    rgba(8, 5, 15, 0.08),
    rgba(8, 5, 15, 0.45)
  );
  z-index: 1;
}

.contact-bar h2 {
  position: relative;
  z-index: 2;

  margin: 0 0 1.25rem;
  height: auto;

  color: #fff;
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 700;
  line-height: 1.15;

  text-shadow: 0 3px 14px rgba(0, 0, 0, 0.7);
}

.btne {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 150px;
  padding: 12px 34px;

  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 999px;

  background: rgba(35, 20, 50, 0.65);
  backdrop-filter: blur(8px);

  color: #fff;
  font-size: 1.1rem;
  font-weight: 700;
  text-decoration: none;

  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.btne:hover {
  transform: translateY(-3px);
  background: rgba(121, 9, 150, 0.8);
  border-color: rgba(255, 255, 255, 0.7);
  box-shadow: 0 12px 30px rgba(121, 9, 150, 0.35);
}

   
  

  @media (max-width: 768px) {
    .card-grid,
    .services-row {
      grid-template-columns: 1fr;
    }
  }
</style>