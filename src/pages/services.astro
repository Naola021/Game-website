---

import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services — ~DemoGames',
};

const services = [
  { icon: '🎨', title: 'Game Design', detail: 'Concepting, prototyping, and design systems for new titles.' },
  { icon: '💻', title: 'Development', detail: 'Full-cycle development across PC, console, and mobile.' },
  { icon: '🚀', title: 'Publishing', detail: 'Bringing finished titles to market across major storefronts.' },
  { icon: '🤝', title: 'Co-Development', detail: 'Partnering with other studios on scope, art, or engineering.' },
  { icon: '🛠️', title: 'Support & Live Ops', detail: 'Post-launch updates, patches, and live game operations.' },
];

const faqs = [
  {
    q: 'What does the engagement process look like?',
    a: 'We start with a scoping call to understand your project, follow with a proposal and timeline, then move into iterative development with regular check-ins.',
  },
  {
    q: 'What platforms do you develop for?',
    a: 'PC, major consoles, and mobile (iOS/Android) — the right target platform depends on the project.',
  },
];
---

<PageLayout metadata={metadata}>
  <div class="page-gradient">
  <!-- Hero -->
  <section class="page-hero">
    <h1>Services</h1>
  </section>

  <!-- Services we give -->
  <section class="section">
    <h2 class="section-title">Services we give</h2>
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card">
            <div class="service-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p class="service-detail">{s.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <h2 class="section-title">FAQ</h2>
    <div class="faq-list" id="faqList">
      {
        faqs.map((faq, i) => (
          <div class="faq-item" data-index={i}>
            <button class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>
  </div>
</PageLayout>

<script>
  const items = document.querySelectorAll('.faq-item');
  items.forEach((item) => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      items.forEach((i) => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });
</script>

<style>
    .page-gradient {
    background: var(--page-gradient);
  }

  .page-hero {
    background-image: url('/serves.png');
    /* background: linear-gradient(135deg, var(--brand-purple-dark), var(--brand-purple-darker)); */
    height: 250px;

      color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
    
  }
  .page-hero h1 {
    color: #fff;
    font-size: 3rem;
    font-weight: 900;
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .section-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: left;
    color: var(--text-dark);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .service-card {
   border: 1px solid rgb(60, 3, 94);
    border-radius: 10px;
    padding: 1.5rem;
    text-align: center;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
    overflow: hidden;
  }
  .service-card:hover {
    box-shadow: 0 10px 24px rgba(124, 58, 237, 0.15);
    border-color: var(--brand-purple);
    transform: translateY(-2px);
  }
  .service-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .service-card h3 {
    font-size: 1rem;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }
  .service-detail {
    color: var(--text-muted);
    font-size: 0.85rem;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.2s ease, opacity 0.2s ease;
  }
  .service-card:hover .service-detail {
    max-height: 100px;
    opacity: 1;
  }

  .faq-list {
    max-width: 700px;
  }
  .faq-item {
    border-bottom: 1px solid var(--border-color);
  }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 1.1rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    color: var(--text-dark);
  }
  .faq-icon {
    color: var(--brand-purple);
    transition: transform 0.2s ease;
  }
  .faq-item.open .faq-icon {
    transform: rotate(180deg);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .faq-item.open .faq-answer {
    max-height: 200px;
  }
  .faq-answer p {
    padding-bottom: 1.1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>