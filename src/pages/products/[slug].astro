---
// src/pages/products/[slug].astro
import PageLayout from '~/layouts/PageLayout.astro';
import { products } from '~/data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const metadata = {
  title: `${product.title} — [Your Gaming Company]`,
};
---

<PageLayout metadata={metadata}>
  <section class="section">
     <a href="/products" class="back-link">← Back to Products</a>
    <div class="title-row">
      <h1>{product.title}</h1>
      <div class="badges">
        <span class="badge">{product.platform}</span>
        <span class="badge">{product.genre}</span>
        <span class="badge">{product.status}</span>
      </div>
    </div>

    {
      product.trailerUrl ? (
        <div class="trailer">
          <iframe
            src={product.trailerUrl}
            title={`${product.title} trailer`}
            allowfullscreen
          />
        </div>
      ) : !product.images?.length ? (
        <div class="trailer">
          <span class="trailer-placeholder">[Trailer / gameplay video]</span>
        </div>
      ) : null
    }

    {
      product.images && product.images.length > 0 && (
        <div class="gallery" aria-label={`${product.title} screenshots`}>
          <button class="gallery-arrow gallery-arrow-left" id="galleryPrev" aria-label="Previous screenshot">
            &#8249;
          </button>
          <div class="gallery-track" id="galleryTrack">
            {product.images.map((src: string, i: number) => (
              <img src={src} alt={`${product.title} screenshot ${i + 1}`} class="gallery-item" loading="lazy" />
            ))}
          </div>
          <button class="gallery-arrow gallery-arrow-right" id="galleryNext" aria-label="Next screenshot">
            &#8250;
          </button>
        </div>
      )
    }

    <div class="action-row">
      <a href={product.purchaseLink || '#'} class="btn btn-primary btn-block">Buy / Wishlist</a>
     
    </div>

    <div class="main-col">
      <h2>About</h2>
      <p class="description">{product.description}</p>

      {
        product.features?.length > 0 && (
          <>
            <h2>Features</h2>
            <ul class="feature-list">
              {product.features.map((f: string) => (
                <li>{f}</li>
              ))}
            </ul>
          </>
        )
      }

      {
        product.systemRequirements && (
          <>
            <h2>System Requirements</h2>
            <p class="description">{product.systemRequirements}</p>
          </>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .section {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .title-row {
    margin-bottom: 1.5rem;
    margin-top:15px;
  }
  .title-row h1 {
    font-size: 2rem;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }
  .badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .badge {
    font-size: 0.78rem;
    color: var(--brand-purple);
    background: var(--brand-purple-light);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 1.5rem 0 2.5rem;
  }
  .action-row .btn-block {
    flex: 0 0 auto;
    min-width: 220px;
  }

  .trailer {
    background: var(--surface-alt);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .trailer iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  .trailer-placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .gallery {
    position: relative;
    margin-bottom: 2rem;
  }
  .gallery-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: 10px;
    scrollbar-width: none;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-item {
    flex: 0 0 100%;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    scroll-snap-align: start;
    background: var(--surface-alt);
  }
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: rgba(20, 8, 40, 0.65);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .gallery-arrow:hover {
    background: var(--brand-purple);
    border-color: var(--brand-purple);
  }
  .gallery-arrow-left {
    left: 10px;
  }
  .gallery-arrow-right {
    right: 10px;
  }
  @media (max-width: 768px) {
    .gallery-arrow {
      display: none;
    }
  }

  h2 {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.75rem;
  }
  .description {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .feature-list {
    list-style: none;
    padding: 0;
  }
  .feature-list li {
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .btn-block {
    display: block;
    text-align: center;
    padding: 0.85rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .btn-primary {
    background: var(--brand-purple);
    color: #fff;
    transition: background 0.15s ease;
  }
  .btn-primary:hover {
    background: var(--brand-purple-dark);
  }
  .back-link {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 30px;
    margin-top: 0px;
  }
  .back-link:hover {
    color: var(--brand-purple);
  }

  @media (max-width: 600px) {
    .action-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .action-row .btn-block {
      min-width: 0;
    }
  }
</style>

<script>
  const track = document.getElementById('galleryTrack');
  const prevBtn = document.getElementById('galleryPrev');
  const nextBtn = document.getElementById('galleryNext');

  function scrollByOneItem(direction: number) {
    if (!track) return;
    track.scrollBy({ left: track.clientWidth * direction, behavior: 'smooth' });
  }

  prevBtn?.addEventListener('click', () => scrollByOneItem(-1));
  nextBtn?.addEventListener('click', () => scrollByOneItem(1));
</script>