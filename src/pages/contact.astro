---
// src/pages/contact.astro
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: "Contact Us — Let's Get In Touch | FMS IT Solution PLC",
  description:
    'Get in touch with FMS IT Solution PLC to discuss game development projects, playable prototypes, partnerships, or studio estimates.',
};
---

<PageLayout metadata={metadata}>
  <!-- Grand Hero Banner with Specular White Gradient Ending Edge -->
  <section
    class="hero-grand-canvas pt-28 pb-16 sm:pt-36 sm:pb-24 rounded-b-[2.5rem] sm:rounded-b-[4rem] text-white relative z-20"
  >
    <div class="flute-overlay"></div>

    <!-- Specular White Gradient Ending Edge -->
    <div class="hero-white-edge"></div>
    <div class="hero-white-glow"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
      <!-- Sleek Black Badge -->
      <div
        class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-black/60 border border-white/20 text-white/90 backdrop-blur-md mb-6 shadow-xs"
      >
        <span>OUR COMMUNICATION</span>
      </div>

      <!-- Architectural Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-white leading-[1.05]">
        Let's Get In<br />
        <span class="bg-gradient-to-r from-emerald-400 via-emerald-300 to-[#0CDAFC] bg-clip-text text-transparent"
          >Touch</span
        >
      </h1>

      <p class="mt-5 text-sm sm:text-base lg:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        Have a game idea, technical question, or looking to build a new title? Send us a message and our team will get
        back to you promptly.
      </p>
    </div>
  </section>

  <!-- Main Grid: Form + Studio Details + Embedded Map -->
  <section class="py-16 sm:py-24 relative z-10 bg-white dark:bg-[#060c08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- Left: Contact Form (Col Span 7) -->
        <div class="lg:col-span-7">
          <div class="editorial-card p-6 sm:p-9">
            <div class="mb-6 pb-5 border-b border-slate-200/80 dark:border-white/[0.08]">
              <span
                class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 block mb-1"
              >
                Direct Inquiry
              </span>
              <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight">
                Send Us a Message
              </h2>
            </div>

            <form
              id="simpleContactForm"
              class="space-y-5"
              data-endpoint="https://formspree.io/f/maewavdw"
              method="POST"
            >
              <!-- Name & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                <div class="space-y-1.5">
                  <label
                    for="name"
                    class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                  >
                    Your Name <span class="text-emerald-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="e.g. Dawit Bekele"
                    class="w-full rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-300 dark:border-white/[0.1] px-4 py-3 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all shadow-xs"
                  />
                </div>

                <div class="space-y-1.5">
                  <label
                    for="email"
                    class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                  >
                    Email Address <span class="text-emerald-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="e.g. name@example.com"
                    class="w-full rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-300 dark:border-white/[0.1] px-4 py-3 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all shadow-xs"
                  />
                </div>
              </div>

              <!-- Subject / Topic -->
              <div class="space-y-1.5">
                <label
                  for="subject"
                  class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >
                  Subject or Project Topic
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="e.g. 3D Game Prototype / Full Game Production"
                  class="w-full rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-300 dark:border-white/[0.1] px-4 py-3 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all shadow-xs"
                />
              </div>

              <!-- Message -->
              <div class="space-y-1.5">
                <label
                  for="message"
                  class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300"
                >
                  Message <span class="text-emerald-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows={5}
                  required
                  placeholder="Tell us about what you have in mind..."
                  class="w-full rounded-xl bg-slate-50 dark:bg-white/[0.03] border border-slate-300 dark:border-white/[0.1] p-4 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all resize-y shadow-xs"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  id="submitBtn"
                  class="btn-pill-emerald w-full justify-center text-sm py-4 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span>SEND MESSAGE →</span>
                </button>
              </div>

              <!-- Success Message (Clean, box & green border removed) -->
              <div
                id="successMsg"
                class="hidden pt-3 flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300"
              >
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#0CDAFC] mt-1.5 shrink-0 shadow-[0_0_8px_rgba(12,218,252,0.6)]"
                ></span>
                <div>
                  <strong class="font-bold text-slate-900 dark:text-white block text-base"
                    >Message Sent Successfully!</strong
                  >
                  Thank you for reaching out. We will get back to you soon.
                </div>
              </div>

              <!-- Error Message -->
              <div id="errorMsg" class="hidden pt-3 flex items-start gap-3 text-sm text-rose-700 dark:text-rose-400">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 mt-1.5 shrink-0"></span>
                <div>
                  <strong class="font-bold text-slate-900 dark:text-white block text-base">Submission Error</strong>
                  Something went wrong sending your message. Please email us directly at <a
                    href="mailto:ceo@fms.et"
                    class="underline font-bold">ceo@fms.et</a
                  >.
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Right: Studio Details & Embedded Map (Col Span 5) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Direct Channels Card (Dark Luxury Design like FAQ section) -->
          <div class="rounded-3xl bg-[#060c08] border border-white/[0.08] text-white p-6 sm:p-8 shadow-2xl space-y-5">
            <div class="space-y-1 pb-2 border-b border-white/[0.08]">
              <span
                class="text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-emerald-400 to-[#0CDAFC] bg-clip-text text-transparent block"
              >
                Contact Studio
              </span>
              <h3 class="text-xl font-black text-white uppercase tracking-tight">Direct Channels</h3>
            </div>

            <div class="space-y-3.5 text-sm">
              <div
                class="p-4 rounded-2xl bg-[#09100b] border border-white/[0.06] space-y-1.5 hover:border-[#0CDAFC]/30 transition-colors"
              >
                <span class="text-xs font-bold uppercase tracking-wider text-[#0CDAFC] block"> Our Emails </span>
                <div class="flex flex-col gap-1 pt-0.5 font-mono text-xs sm:text-sm text-slate-200">
                  <a href="mailto:ceo@fms.et" class="hover:text-[#0CDAFC] transition-colors"> ceo@fms.et </a>
                  <a href="mailto:Fmsitsolutionplc@gmail.com" class="hover:text-[#0CDAFC] transition-colors">
                    Fmsitsolutionplc@gmail.com
                  </a>
                </div>
              </div>

              <div
                class="p-4 rounded-2xl bg-[#09100b] border border-white/[0.06] space-y-1.5 hover:border-[#0CDAFC]/30 transition-colors"
              >
                <span class="text-xs font-bold uppercase tracking-wider text-[#0CDAFC] block"> Phone & WhatsApp </span>
                <div class="flex flex-col gap-1 pt-0.5 font-mono text-xs sm:text-sm text-slate-200">
                  <a href="tel:+251112306006" class="hover:text-[#0CDAFC] transition-colors"> +251 11 230 6006 </a>
                  <a href="tel:+251966709993" class="hover:text-[#0CDAFC] transition-colors"> +251 966 709 993 </a>
                  <a href="tel:+251995404181" class="hover:text-[#0CDAFC] transition-colors"> +251 995 404 181 </a>
                </div>
              </div>

              <div
                class="p-4 rounded-2xl bg-[#09100b] border border-white/[0.06] space-y-1.5 hover:border-[#0CDAFC]/30 transition-colors"
              >
                <span class="text-xs font-bold uppercase tracking-wider text-[#0CDAFC] block"> Location </span>
                <p class="pt-0.5 text-xs sm:text-sm text-slate-300 font-medium">Addis Ababa, Ethiopia</p>
              </div>
            </div>
          </div>

          <!-- Embedded Map Card -->
          <div class="editorial-card p-4 sm:p-5 space-y-3">
            <div class="flex items-center justify-between px-1">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Our Location</span
              >
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">Addis Ababa</span>
            </div>

            <!-- Map Iframe Container -->
            <div
              class="w-full h-64 sm:h-72 rounded-2xl overflow-hidden border border-slate-200 dark:border-white/[0.08] shadow-inner relative"
            >
              <iframe
                title="FMS IT Solution Studio Location"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126115.11523450917!2d38.68532468305886!3d8.963176767597143!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x164b85cef5ab402d%3A0x8467b6b037a24d49!2sAddis%20Ababa%2C%20Ethiopia!5e0!3m2!1sen!2set!4v1700000000000!5m2!1sen!2set"
                class="w-full h-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Script -->
  <script>
    const form = document.getElementById('simpleContactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const successMsg = document.getElementById('successMsg');
    const errorMsg = document.getElementById('errorMsg');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>SENDING MESSAGE...</span>';

      errorMsg?.classList.add('hidden');
      successMsg?.classList.add('hidden');

      try {
        const endpoint = form.dataset.endpoint || 'https://formspree.io/f/maewavdw';
        const formData = new FormData(form);

        const response = await fetch(endpoint, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
          submitBtn.innerHTML = '<span>MESSAGE SENT!</span>';
        } else {
          errorMsg?.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      } catch {
        errorMsg?.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  </script>
</PageLayout>
