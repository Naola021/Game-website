---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact — [Your Gaming Company]',
};
---

<PageLayout metadata={metadata}>
  <!-- Hero -->
  <section class="page-hero">
    <h1>Contact</h1>
  </section>

  <section class="section">
    <div class="contact-grid">

      <!-- Contact Form -->
      <form id="contactForm" class="contact-form" novalidate>

        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
          <span class="error-msg">Please enter your name.</span>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
          <span class="error-msg">Please enter a valid email address.</span>
        </div>

        <div class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required />
          <span class="error-msg">Please enter a subject.</span>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
          <span class="error-msg">Please enter a message.</span>
        </div>

        <button type="submit" class="btn btn-primary">Send</button>

        <p id="successMsg" class="success-msg">
          Thanks — your message has been sent! We'll be in touch soon.
        </p>

      </form>


      <!-- Contact Details -->
      <div class="contact-details">

        <h3>Get in Touch</h3>

        <p>
          <strong>Address:</strong><br />
          Addis Ababa, Ethiopia
        </p>

        <p>
          <strong>Email:</strong><br />
          contact@demogames.com
        </p>

        <p>
          <strong>Phone:</strong><br />
          +251 987 654 321
        </p>


        <!-- Social Links -->
        <div class="social-icons">

          <!-- Facebook -->
          <a href="https://facebook.com" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/>
            </svg>
          </a>

          <!-- X -->
          <a href="https://x.com" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.9L4.5 22H1.4l8.1-9.3L1 2h7l4.9 6.3L18.9 2Zm-1.2 18h1.9L6.4 4h-2l13.3 16Z"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href="https://linkedin.com" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.6h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9-1.8 0-2 1.4-2 2.8V21h-4V9Z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a href="https://instagram.com" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2c-2.7 0-3.1 0-4.1.1-1.1 0-1.8.2-2.4.5-.7.3-1.2.6-1.8 1.2-.6.6-.9 1.1-1.2 1.8-.3.6-.5 1.3-.5 2.4C2 9 2 9.4 2 12s0 3.1.1 4.1c0 1.1.2 1.8.5 2.4.3.7.6 1.2 1.2 1.8.6.6 1.1.9 1.8 1.2.6.3 1.3.5 2.4.5C9 22 9.4 22 12 22s3.1 0 4.1-.1c1.1 0 1.8-.2 2.4-.5.7-.3 1.2-.6 1.8-1.2.6-.6.9-1.1-1.2-1.8-.3-.6-.5-1.3-.5-2.4.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c0-1.1-.2-1.8-.5-2.4-.3-.7-.6-1.2-1.2-1.8-.6-.6-1.1-.9-1.8-1.2-.6-.3-1.3-.5-2.4-.5C15.1 2 14.7 2 12 2Zm0 1.8c2.6 0 2.9 0 4 .1.9 0 1.5.2 1.8.3.5.2.8.4 1.1.7.3.3.5.6.7 1.1.2.3.3.9.3 1.8.1 1.1.1 1.4.1 4s0 2.9-.1 4c0 .9-.2 1.5-.3 1.8-.2.5-.4.8-.7 1.1-.3.3-.6.5-1.1.7-.3.2-.9.3-1.8.3-1.1.1-1.4.1-4 .1s-2.9 0-4-.1c-.9 0-1.5-.2-1.8-.3-.5-.2-.8-.4-1.1-.7-.3-.3-.5-.6-.7-1.1-.2-.3-.3-.9-.3-1.8-.1-1.1-.1-1.4-.1-4s0-2.9.1-4c0-.9.2-1.5.3-1.8.2-.5.4-.8.7-1.1.3-.3.6-.5 1.1-.7.3-.2.9-.3 1.8-.3 1.1-.1 1.4-.1 4-.1Zm0 3.2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/>
            </svg>
          </a>

        </div>
      </div>


      <!-- Map -->
      <div class="map-embed">
        <span>[Embedded Google Map]</span>
      </div>

    </div>
  </section>
</PageLayout>


<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const successMsg = document.getElementById('successMsg');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    let valid = true;

    form.querySelectorAll('input, textarea').forEach((el) => {
      const input = el as HTMLInputElement;
      const field = input.closest('.field');

      const isEmpty = input.value.trim() === '';
      const isEmail = input.type === 'email';

      const emailInvalid =
        isEmail &&
        input.value.trim() !== '' &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value);

      if (isEmpty || emailInvalid) {
        field?.classList.add('invalid');
        valid = false;
      } else {
        field?.classList.remove('invalid');
      }
    });

    if (valid) {
      form.style.display = 'none';
      successMsg?.classList.add('visible');
    }
  });
</script>


<style>
 .page-hero {
    background-image: url('/contact.png');
    /* background: linear-gradient(135deg, var(--brand-purple-dark), var(--brand-purple-darker)); */
    height: 250px;

      color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
    
  }

  .page-hero h1 {
    color: #fff;
    font-size: 3rem;
    font-weight: 900;
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .contact-form {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.75rem;
  }

  .field {
    margin-bottom: 1.1rem;
  }

  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--text-dark);
  }

  .field input,
  .field textarea {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    font-size: 0.9rem;
    font-family: inherit;
    box-sizing: border-box;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--brand-purple);
  }

  .error-msg {
    display: none;
    color: #dc2626;
    font-size: 0.78rem;
    margin-top: 0.3rem;
  }

  .field.invalid input,
  .field.invalid textarea {
    border-color: #dc2626;
  }

  .field.invalid .error-msg {
    display: block;
  }

  .btn-primary {
    background: var(--brand-purple);
    color: #fff;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: var(--brand-purple-dark);
    transform: translateY(-2px);
  }

  .success-msg {
    display: none;
    margin-top: 1rem;
    color: #15803d;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .success-msg.visible {
    display: block;
  }

  .contact-details {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.75rem;
  }

  .contact-details h3 {
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .contact-details p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .contact-details strong {
    color: var(--text-dark);
  }


  /* Social Icons — same style as footer */
  .social-icons {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .social-icons a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-color);

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--text-muted);
    text-decoration: none;

    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .social-icons svg {
    width: 16px;
    height: 16px;
  }

  .social-icons a:hover {
    color: var(--brand-purple);
    border-color: var(--brand-purple);
    transform: translateY(-2px);
  }


  /* Map — unchanged */
  .map-embed {
    background: var(--brand-purple-light);
    border-radius: 10px;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }


  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>