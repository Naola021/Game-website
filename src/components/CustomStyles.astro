---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Inter Variable', ui-serif, Georgia, serif;
    --aw-font-heading: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: rgb(16 185 129);
    --aw-color-secondary: rgb(5 150 105);
    --aw-color-accent: rgb(52 211 153);

    --aw-color-text-heading: rgb(15 23 42);
    --aw-color-text-default: rgb(51 65 85);
    --aw-color-text-muted: rgb(100 116 139);
    --aw-color-bg-page: rgb(250 250 252);
    --aw-color-bg-page-dark: rgb(9 14 11);

    ::selection {
      background-color: rgb(16 185 129 / 25%);
      color: rgb(6 78 59);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Inter Variable', ui-serif, Georgia, serif;
    --aw-font-heading: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: rgb(52 211 153);
    --aw-color-secondary: rgb(16 185 129);
    --aw-color-accent: rgb(110 231 183);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);
    --aw-color-bg-page: rgb(9 14 11);

    ::selection {
      background-color: rgb(16 185 129 / 40%);
      color: #ffffff;
    }
  }
</style>
