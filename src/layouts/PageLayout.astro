---
// src/layouts/PageLayout.astro
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<Layout metadata={metadata}>
  <!-- Ambient Subtle Grid -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="bg-grid-subtle absolute inset-0 opacity-40 dark:opacity-20"></div>
  </div>

  <!-- Classy Floating Glass Header (No enclosing white box) -->
  <header class="site-header fixed top-0 inset-x-0 z-50 py-4 px-4 sm:px-6 lg:px-8 transition-all duration-300" id="siteHeader">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo - Clean, High-Contrast & Sleek -->
      <a href="/" class="logo-link flex items-center gap-3.5 group">
        <div class="logo-badge relative w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center p-2 group-hover:border-emerald-400 group-hover:scale-105 transition-all duration-300 shadow-lg backdrop-blur-md">
          <img src="/logo.svg" alt="FMS IT Solution PLC Logo" class="w-full h-full object-contain filter drop-shadow" />
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-black tracking-tight text-white leading-tight group-hover:text-emerald-400 transition-colors drop-shadow-sm">
            FMS IT Solution
          </span>
          <span class="text-[10px] sm:text-[11px] uppercase tracking-widest text-emerald-400 font-bold">
            Game Studio
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links - Floating Glass Capsule -->
      <nav class="hidden md:flex items-center gap-1.5 bg-black/40 border border-white/15 rounded-full px-3.5 py-1.5 backdrop-blur-xl shadow-2xl">
        {
          navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class:list={[
                  'relative px-4 py-1.5 text-xs font-semibold uppercase tracking-wider rounded-full transition-all duration-200',
                  isActive
                    ? 'text-white bg-emerald-600 shadow-md'
                    : 'text-white/80 hover:text-white hover:bg-white/10',
                ]}
              >
                {link.name}
              </a>
            );
          })
        }
      </nav>

      <!-- Header Right CTA - Sleek Pill Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/contact"
          class="btn-pill-emerald text-xs font-bold px-6 py-2.5 shadow-xl hover:scale-105 transition-transform"
        >
          <span>Let's get in touch</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        id="mobileMenuBtn"
        aria-label="Toggle Navigation Menu"
        class="md:hidden p-2.5 rounded-full text-white bg-black/40 border border-white/15 backdrop-blur-xl transition-colors shadow-lg"
      >
        <svg id="hamburgerIcon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="closeIcon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Mobile Drawer Menu -->
    <div
      id="mobileDrawer"
      class="hidden md:hidden mt-3 mx-auto max-w-lg rounded-3xl bg-[#060c08]/95 backdrop-blur-2xl border border-white/15 p-5 shadow-2xl text-white"
    >
      <div class="flex flex-col gap-2">
        {
          navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class:list={[
                  'px-4 py-3 rounded-2xl text-sm font-semibold uppercase tracking-wider flex items-center justify-between transition-colors',
                  isActive
                    ? 'bg-emerald-600 text-white'
                    : 'text-slate-300 hover:bg-white/[0.06] hover:text-white',
                ]}
              >
                <span>{link.name}</span>
                {isActive && <span class="w-2 h-2 rounded-full bg-white" />}
              </a>
            );
          })
        }
      </div>

      <div class="mt-4 pt-4 border-t border-white/10">
        <a
          href="/contact"
          class="w-full justify-center btn-pill-emerald text-xs"
        >
          <span>Let's get in touch</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Page Content -->
  <main class="relative z-10 min-h-[calc(100vh-350px)]">
    <slot />
  </main>

  <!-- Architectural Studio Dark Footer -->
  <footer class="relative z-10 bg-[#060c08] text-white pt-16 pb-12 overflow-hidden border-t border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Footer Main Columns -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-14 border-b border-white/[0.08]">
        
        <!-- Brand & Description (Col Span 5) -->
        <div class="lg:col-span-5 space-y-5">
          <a href="/" class="flex items-center gap-3.5 inline-flex">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center p-2 shadow-md">
              <img src="/logo.svg" alt="FMS IT Solution Logo" class="w-full h-full object-contain" />
            </div>
            <div class="flex flex-col">
              <span class="text-xl font-black text-white tracking-tight">
                FMS IT Solution PLC
              </span>
              <span class="text-[11px] uppercase tracking-widest text-emerald-400 font-bold">
                Game Development Studio
              </span>
            </div>
          </a>

          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm font-normal">
            A dedicated game development studio engineered to build high-retention, commercially successful games across mobile, PC, and web browsers.
          </p>
        </div>

        <!-- Privacy & Legal Links (Col Span 2) -->
        <div class="lg:col-span-2 space-y-3">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-widest">
            Privacy & Legal
          </h3>
          <ul class="space-y-2.5 text-xs text-slate-400">
            <li><a href="/privacy" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-emerald-400 transition-colors">Terms of Service</a></li>
            <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Project Inquiries</a></li>
          </ul>
        </div>

        <!-- Page Links (Col Span 2) -->
        <div class="lg:col-span-2 space-y-3">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-widest">
            Pages
          </h3>
          <ul class="space-y-2.5 text-xs text-slate-400">
            <li><a href="/" class="hover:text-emerald-400 transition-colors">Home</a></li>
            <li><a href="/services" class="hover:text-emerald-400 transition-colors">Services</a></li>
            <li><a href="/about" class="hover:text-emerald-400 transition-colors">About Studio</a></li>
            <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- Studio Capabilities (Col Span 3) -->
        <div class="lg:col-span-3 space-y-3">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-widest">
            Capabilities
          </h3>
          <ul class="space-y-2.5 text-xs text-slate-400">
            <li><a href="/services#game-design" class="hover:text-emerald-400 transition-colors">Game Design & Blueprinting</a></li>
            <li><a href="/services#full-cycle" class="hover:text-emerald-400 transition-colors">Full-Cycle Game Engineering</a></li>
            <li><a href="/services#game-art" class="hover:text-emerald-400 transition-colors">3D Art, VFX & Shaders</a></li>
            <li><a href="/services#monetization" class="hover:text-emerald-400 transition-colors">Economy & Balancing</a></li>
            <li><a href="/services#live-ops" class="hover:text-emerald-400 transition-colors">Live Ops & Multi-Store Launch</a></li>
          </ul>
        </div>

      </div>

      <!-- Bottom Bar & Massive Watermark -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>&copy; 2026 FMS IT Solution PLC. All rights reserved.</p>
        <p class="text-slate-400 font-mono text-[11px]">Addis Ababa, Ethiopia</p>
      </div>

      <!-- Watermark Brand Name -->
      <div class="mt-8 pt-4 overflow-hidden select-none pointer-events-none text-center">
        <span class="text-[4rem] sm:text-[7rem] md:text-[9rem] lg:text-[11rem] font-black uppercase tracking-tighter text-white/[0.03] leading-none block">
          FMS IT STUDIO
        </span>
      </div>

    </div>
  </footer>

  <script>
    // Header scroll adaptive subtle glass (more transparent & lighter blur)
    const header = document.getElementById('siteHeader');

    const updateHeader = () => {
      if (window.scrollY > 25) {
        header?.classList.add('bg-[#060c08]/35', 'backdrop-blur-md', 'border-b', 'border-white/[0.06]', 'shadow-lg', 'py-3');
        header?.classList.remove('py-4');
      } else {
        header?.classList.remove('bg-[#060c08]/35', 'backdrop-blur-md', 'border-b', 'border-white/[0.06]', 'shadow-lg', 'py-3');
        header?.classList.add('py-4');
      }
    };

    window.addEventListener('scroll', updateHeader);
    updateHeader();

    // Mobile Hamburger Toggle
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const hamburgerIcon = document.getElementById('hamburgerIcon');
    const closeIcon = document.getElementById('closeIcon');

    mobileBtn?.addEventListener('click', () => {
      const isOpen = !mobileDrawer?.classList.contains('hidden');
      if (isOpen) {
        mobileDrawer?.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileDrawer?.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    });
  </script>

  <style is:global>
    :root {
      --bg-main: #ffffff;
      --bg-surface: #ffffff;
      --bg-surface-elevated: #f8fafc;
      --color-primary: #059669;
    }

    .dark {
      --bg-main: #060c08;
      --bg-surface: #0a120d;
      --bg-surface-elevated: #0f1912;
      --color-primary: #10b981;
    }

    body {
      background-color: var(--bg-main);
      color: #1e293b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      overflow-x: hidden;
    }

    .dark body {
      color: #f1f5f9;
    }

    .bg-grid-subtle {
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(0, 0, 0, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    }

    .dark .bg-grid-subtle {
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    }
  </style>
</Layout>