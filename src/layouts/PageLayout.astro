---
// src/layouts/PageLayout.astro
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
 

 <!-- Announcement Banner -->
  <div class="announcement" id="announcement">
    <span>New game launching next week — stay tuned!</span>
    <button id="closeAnnouncement" aria-label="Dismiss announcement">&times;</button>
  </div>
  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="header-inner">
      <a href="/" class="logo-link">
        <img src="/logo.svg" alt="[Demo Gaming Company] logo" class="logo-img" />
      </a>

      <nav class="main-nav" id="mainNav">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/products">Products</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>

      <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>
  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
        <img src="/logo.svg" alt="[Your Gaming Company] logo" class="logo-img" />
        <p class="footer-tagline">Crafting worlds worth playing.</p>
        <div class="social-icons">
          <a href="https://facebook.com" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="https://x.com" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.9L4.5 22H1.4l8.1-9.3L1 2h7l4.9 6.3L18.9 2Zm-1.2 18h1.9L6.4 4h-2l13.3 16Z"/></svg>
          </a>
          <a href="https://linkedin.com" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.6h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9-1.8 0-2 1.4-2 2.8V21h-4V9Z"/></svg>
          </a>
          <a href="https://instagram.com" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-2.7 0-3.1 0-4.1.1-1.1 0-1.8.2-2.4.5-.7.3-1.2.6-1.8 1.2-.6.6-.9 1.1-1.2 1.8-.3.6-.5 1.3-.5 2.4C2 9 2 9.4 2 12s0 3.1.1 4.1c0 1.1.2 1.8.5 2.4.3.7.6 1.2 1.2 1.8.6.6 1.1.9 1.8 1.2.6.3 1.3.5 2.4.5C9 22 9.4 22 12 22s3.1 0 4.1-.1c1.1 0 1.8-.2 2.4-.5.7-.3 1.2-.6 1.8-1.2.6-.6.9-1.1 1.2-1.8.3-.6.5-1.3.5-2.4.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c0-1.1-.2-1.8-.5-2.4-.3-.7-.6-1.2-1.2-1.8-.6-.6-1.1-.9-1.8-1.2-.6-.3-1.3-.5-2.4-.5C15.1 2 14.7 2 12 2Zm0 1.8c2.6 0 2.9 0 4 .1.9 0 1.5.2 1.8.3.5.2.8.4 1.1.7.3.3.5.6.7 1.1.2.3.3.9.3 1.8.1 1.1.1 1.4.1 4s0 2.9-.1 4c0 .9-.2 1.5-.3 1.8-.2.5-.4.8-.7 1.1-.3.3-.6.5-1.1.7-.3.2-.9.3-1.8.3-1.1.1-1.4.1-4 .1s-2.9 0-4-.1c-.9 0-1.5-.2-1.8-.3-.5-.2-.8-.4-1.1-.7-.3-.3-.5-.6-.7-1.1-.2-.3-.3-.9-.3-1.8-.1-1.1-.1-1.4-.1-4s0-2.9.1-4c0-.9.2-1.5.3-1.8.2-.5.4-.8.7-1.1.3-.3.6-.5 1.1-.7.3-.2.9-.3 1.8-.3 1.1-.1 1.4-.1 4-.1Zm0 3.2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <a href="/services">Services</a>
        <a href="/products">Products</a>
        <a href="/projects">Projects</a>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 [Your Gaming Company]. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const banner = document.getElementById('announcement');
    document.getElementById('closeAnnouncement')?.addEventListener('click', () => banner?.remove());

    const header = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => {
      header?.classList.toggle('scrolled', window.scrollY > 20);
    });

    const hamburger = document.getElementById('hamburgerBtn');
    const nav = document.getElementById('mainNav');
    hamburger?.addEventListener('click', () => {
      nav?.classList.toggle('open');
      hamburger?.classList.toggle('active');
    });

    const currentPath = window.location.pathname;
    document.querySelectorAll('.main-nav a').forEach((link) => {
      if (link.getAttribute('href') === currentPath) link.classList.add('active');
    });
  </script>

  <style is:global>
    /* ===== Dark theme brand palette — shared across every page ===== */
    :root {
      --brand-purple: #a78bfa;
      --brand-purple-dark: #8b5cf6;
      --brand-purple-darker: #6d28d9;
      --brand-purple-light: rgba(167, 139, 250, 0.12);
      --text-dark: #f4f4f5;
      --text-muted: #a1a1aa;
      --border-color: #2a2a2e;
      --surface: #0c0c0e;
      --surface-alt: #151517;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      color: var(--text-dark);
      line-height: 1.5;
      background: var(--surface);
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    h1, h2, h3 {
      color: var(--text-dark);
      font-weight: 700;
    }

    /* Announcement banner */
    .announcement {
      background: #2f0055;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
      text-align: center;
      height:60px;
    }
    .announcement button {
      background: none;
      border: none;
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      opacity: 0.8;
    }
    .announcement button:hover {
      opacity: 1;
    }

    /* Header */
    .site-header {
      position: sticky;
      top: 0;
      background: rgba(70, 38, 83, 0.096);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      z-index: 100;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .site-header.scrolled {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      border-color: transparent;
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1.5rem;
      gap: 1.5rem;
    }
    .logo-link {
      display: flex;
      align-items: center;
    }
    .logo-img {
      height: 40px;
      width: auto;
      display: block;
    }
    .main-nav {
      display: flex;
      gap: 1.75rem;
      margin-left: auto;
    }
    .main-nav a {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      padding-bottom: 3px;
      border-bottom: 2px solid transparent;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .main-nav a.active,
    .main-nav a:hover {
      color: var(--text-dark);
      border-bottom-color: var(--brand-purple);
    }
    .header-cta {
      background: var(--brand-purple-dark);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.5rem 1.2rem;
      border-radius: 999px;
      white-space: nowrap;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .header-cta:hover {
      background: var(--brand-purple-darker);
      transform: translateY(-1px);
    }

    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 22px;
      height: 16px;
      background: none;
      border: none;
      cursor: pointer;
    }
    .hamburger span {
      display: block;
      height: 2px;
      width: 100%;
      background: var(--text-dark);
    }

    /* Footer */
    .site-footer {
      background: var(--surface-alt);
      border-top: 1px solid var(--border-color);
      color: var(--text-muted);
      margin-top:0px;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3.5rem 1.5rem 2rem;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2rem;
    }
    .footer-col h4 {
      color: var(--text-dark);
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .footer-col a {
      display: block;
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 0.65rem;
      transition: color 0.15s ease;
    }
    .footer-col a:hover {
      color: var(--brand-purple);
    }
    .footer-brand .footer-logo {
      height: 28px;
      margin-bottom: 0.85rem;
      filter: brightness(0) invert(1);
    }
    .footer-tagline {
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }
    .social-icons {
      display: flex;
      gap: 0.75rem;
    }
    .social-icons a {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .social-icons svg {
      width: 16px;
      height: 16px;
    }
    .social-icons a:hover {
      color: var(--brand-purple);
      border-color: var(--brand-purple);
      transform: translateY(-2px);
    }

    .footer-bottom {
      border-top: 1px solid var(--border-color);
      text-align: center;
      padding: 1.25rem 1.5rem;
      font-size: 0.8rem;
    }

    @media (max-width: 900px) {
      .footer-inner {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .header-cta {
        display: none;
      }
      .main-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--surface);
        flex-direction: column;
        padding: 1rem 1.5rem;
        display: none;
        border-bottom: 1px solid var(--border-color);
      }
      .main-nav.open {
        display: flex;
      }
      .hamburger {
        display: flex;
      }
      .footer-inner {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>