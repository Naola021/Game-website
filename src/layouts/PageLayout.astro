---
// src/layouts/PageLayout.astro
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>

  <!-- Announcement Banner -->
  <div class="announcement" id="announcement">
    <span>New game launching soon — stay tuned!</span>
    <button id="closeAnnouncement" aria-label="Dismiss announcement">&times;</button>
  </div>

  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="header-inner">
      <a href="/" class="logo-link">
  <img src="/logo.svg" alt="FMS IT Solution logo" class="logo-img" />
  <span class="logo-text">FMS IT Solution</span>
</a>

      <nav class="main-nav" id="mainNav">
        
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/services">Services</a>
        <a class="nav-link" href="/products">Products</a>
        <a class="nav-link" href="/projects">Projects</a>
        <a class="nav-link" href="/about">About</a>
        <a class="nav-link" href="/contact">Contact</a>
      </nav>

      <div class="header-right">
      <div class="header-icons">
        <button class="icon-btn" id="themeToggle" aria-label="Toggle light/dark mode">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
        <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7.5-4.6-10-9.3C.5 8 2.3 4.5 5.8 4c2-.3 3.9.6 5 2.3 1.1-1.7 3-2.6 5-2.3 3.5.5 5.3 4 3.8 7.7C19.5 16.4 12 21 12 21Z"/></svg>
          <span class="icon-badge" id="wishlistBadge">0</span>
        </a>
        <a href="/cart" class="icon-btn" aria-label="Cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1.5"/><circle cx="18" cy="21" r="1.5"/><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6"/></svg>
          <span class="icon-badge" id="cartBadge">0</span>
        </a>
      </div>

      <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
       <a href="/" class="logo-link">
        <img src="/logo.svg" alt="FMS IT Solution logo" class="logo-img" />
        <span class="logo-text2">FMS IT Solution PLC</span>
      </a>
        <p class="footer-tagline">Crafting Worlds worth playing.</p>
        <div class="social-icons">
          <a href="https://facebook.com" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="https://x.com" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.9L4.5 22H1.4l8.1-9.3L1 2h7l4.9 6.3L18.9 2Zm-1.2 18h1.9L6.4 4h-2l13.3 16Z"/></svg>
          </a>
          <a href="https://linkedin.com" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.6h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9-1.8 0-2 1.4-2 2.8V21h-4V9Z"/></svg>
          </a>
          <a href="https://instagram.com" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-2.7 0-3.1 0-4.1.1-1.1 0-1.8.2-2.4.5-.7.3-1.2.6-1.8 1.2-.6.6-.9 1.1-1.2 1.8-.3.6-.5 1.3-.5 2.4C2 9 2 9.4 2 12s0 3.1.1 4.1c0 1.1.2 1.8.5 2.4.3.7.6 1.2 1.2 1.8.6.6 1.1.9 1.8 1.2.6.3 1.3.5 2.4.5C9 22 9.4 22 12 22s3.1 0 4.1-.1c1.1 0 1.8-.2 2.4-.5.7-.3 1.2-.6 1.8-1.2.6-.6.9-1.1 1.2-1.8.3-.6.5-1.3.5-2.4.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c0-1.1-.2-1.8-.5-2.4-.3-.7-.6-1.2-1.2-1.8-.6-.6-1.1-.9-1.8-1.2-.6-.3-1.3-.5-2.4-.5C15.1 2 14.7 2 12 2Zm0 1.8c2.6 0 2.9 0 4 .1.9 0 1.5.2 1.8.3.5.2.8.4 1.1.7.3.3.5.6.7 1.1.2.3.3.9.3 1.8.1 1.1.1 1.4.1 4s0 2.9-.1 4c0 .9-.2 1.5-.3 1.8-.2.5-.4.8-.7 1.1-.3.3-.6.5-1.1.7-.3.2-.9.3-1.8.3-1.1.1-1.4.1-4 .1s-2.9 0-4-.1c-.9 0-1.5-.2-1.8-.3-.5-.2-.8-.4-1.1-.7-.3-.3-.5-.6-.7-1.1-.2-.3-.3-.9-.3-1.8-.1-1.1-.1-1.4-.1-4s0-2.9.1-4c0-.9.2-1.5.3-1.8.2-.5.4-.8.7-1.1.3-.3.6-.5 1.1-.7.3-.2.9-.3 1.8-.3 1.1-.1 1.4-.1 4-.1Zm0 3.2a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <a href="/services">Services</a>
        <a href="/products">Products</a>
        <a href="/projects">Projects</a>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 FMS IT Solution PLC. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    // Applied immediately (before body paints) to avoid a flash of the wrong theme
    (function () {
      const saved = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>

  <script>
    const banner = document.getElementById('announcement');
    document.getElementById('closeAnnouncement')?.addEventListener('click', () => banner?.remove());

    const header = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => {
      header?.classList.toggle('scrolled', window.scrollY > 20);
    });

    const hamburger = document.getElementById('hamburgerBtn');
    const nav = document.getElementById('mainNav');
    hamburger?.addEventListener('click', () => {
      nav?.classList.toggle('open');
      hamburger?.classList.toggle('active');
    });

    const currentPath = window.location.pathname;
    document.querySelectorAll('.main-nav a').forEach((link) => {
      if (link.getAttribute('href') === currentPath) link.classList.add('active');
    });

    function updateBadges() {
      const cart = JSON.parse(localStorage.getItem('demo_cart') || '[]');
      const wishlist = JSON.parse(localStorage.getItem('demo_wishlist') || '[]');
      const cartBadge = document.getElementById('cartBadge');
      const wishlistBadge = document.getElementById('wishlistBadge');
      if (cartBadge) cartBadge.textContent = String(cart.length);
      if (wishlistBadge) wishlistBadge.textContent = String(wishlist.length);
    }
    updateBadges();
    window.addEventListener('storage', updateBadges);

    // Light / dark theme toggle
    const themeToggle = document.getElementById('themeToggle');
    themeToggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  </script>

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap');

    html,
    body {
      overflow-x: hidden;
      /* Prevents the full-bleed carousel sections (which use 100vw) from
         causing a horizontal scrollbar and letting cards peek past the
         screen edges. 100vw doesn't account for the scrollbar's own width,
         so it always ends up slightly wider than the visible window. */
    }

    :root {
      --brand-purple: #a78bfa;
      --brand-purple-dark: #8b5cf6;
      --brand-purple-darker: #6d28d9;
      --brand-purple-light: rgba(167, 139, 250, 0.12);
      --text-dark: #f4f4f5;
      --text-muted: #a1a1aa;
      --text-nav: #a1a1aa;
      --border-color: rgba(61, 3, 95, 0.699);
      --border-colors: #2a2a2e;
      --feature-border: rgb(60, 3, 94);
      --surface: #0c0c0e;
      --surface-alt: #151517;
      --page-gradient:  linear-gradient(160deg, #0c0c0e 0%, #150a249c 35%, #1f0f3856 62%, #0c0c0e 100%);
    }

    :root[data-theme='light'] {
      --brand-purple: #7c3aed;
      --brand-purple-dark: #6d28d9;
      --brand-purple-darker: #5b21b6;
      --brand-purple-light: rgba(124, 58, 237, 0.1);
      --text-dark: #3d0a34;
      --text-navh: #000000;
      --text-muted: #0701069d;
      --text-nav: #ffffff;
      --border-color: rgba(13, 13, 14, 0.26);
      --border-colors:#f8f8f852; 
      --feature-border: rgba(13, 13, 14, 0.26);
      --surface: #ffffff;
      --surface-alt: #2f0055;
      --page-gradient: linear-gradient(160deg, #ffffff 0%, #ffffff 35%, #ffffff 62%, #fffffff5 100%);
    }

    /* Mobile-first baseline */
    input,
    textarea,
    select {
      font-size: 16px !important; /* prevents iOS Safari auto-zoom on focus */
    }

    .icon-btn,
    .carousel-arrow,
    button {
      min-height: 44px;
      min-width: 44px; /* comfortable minimum tap target */
    }

    /* Hamburger keeps its own small visual size — the button's clickable
       padding (not this box) is what makes it tappable, so it doesn't need
       to inherit the 44px minimum above. */
    .hamburger {
      min-height: 0;
      min-width: 0;
    }

    @media (max-width: 480px) {
      .header-inner {
        padding: 0.65rem 1rem;
      }
      .logo-img {
        height: 32px;
      }

      /* Shrink the icon cluster so it doesn't crowd small screens */
      .header-right {
        gap: 0.4rem;
      }
      .header-icons {
        gap: 0.3rem;
      }
      .icon-btn {
        width: 26px;
        height: 26px;
        min-width: 26px;
        min-height: 26px;
      }
      .icon-btn svg {
        width: 12px;
        height: 12px;
      }
      .icon-badge {
        width: 12px;
        height: 12px;
        min-width: 12px;
        font-size: 0.55rem;
        top: -3px;
        right: -3px;
      }
      .hamburger {
        width: 16px;
        height: 11px;
      }
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      color: var(--text-dark);
      line-height: 1.5;
      background: var(--surface);
      transition: background 0.2s ease, color 0.2s ease;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    h1, h2, h3 {
      color: var(--text-dark);
      font-weight: 700;
    }

    .announcement {
      background: #2f0055;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
      text-align: center;
      min-height: 44px;
    }
    .announcement button {
      background: none;
      border: none;
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
      opacity: 0.8;
    }
    .announcement button:hover {
      opacity: 1;
    }

    .site-header {
      position: sticky;
      top: 0;
      background: rgba(70, 38, 83, 0.096);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      z-index: 100;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    :root[data-theme='light'] .site-header {
      background:  rgba(70, 38, 83, 0.096);
    }
    .site-header.scrolled {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      border-color: transparent;
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1.5rem;
      gap: 1.5rem;
    }
    .logo-link {
      display: flex;
      align-items: center;
    }
    .logo-img {
      height: 50px;
      width: auto;
      display: block;
    }
    .logo-link {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.logo-text {
  font-family: 'Baloo 2', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  background: linear-gradient(100deg, #4ade80 0%, #2dd4bf 45%, #38bdf8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #2dd4bf;
  white-space: nowrap;
}
.logo-text2{
  font-family: 'Baloo 2', sans-serif;
   font-size: 1.25rem;
  font-weight: 800;
  background: linear-gradient(100deg, #4ade80 0%, #2dd4bf 45%, #38bdf8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #2dd4bf;
   white-space: nowrap;
}
@media (max-width: 480px) {
  .logo-text {
    font-size: 0.85rem;
  }
}
    .main-nav {
      display: flex;
      gap: 1.75rem;
      margin-left: auto;
    }
    .main-nav a {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      padding-bottom: 3px;
      border-bottom: 2px solid transparent;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .main-nav a.active,
    .main-nav a:hover {
      color: var(--text-dark);
      
      border-bottom-color: var(--brand-purple);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .header-icons {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .icon-btn {
      position: relative;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      border: 1px solid var(--border-colors);
      background: none;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .icon-btn svg {
      width: 18px;
      height: 18px;
    }
    .icon-btn:hover {
      color: var(--brand-purple);
      border-color: var(--brand-purple);
      transform: translateY(-2px);
    }
    .icon-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: var(--brand-purple);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      min-width: 17px;
      height: 17px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
    }

    /* Theme toggle icon swap */
    #themeToggle .icon-moon {
      display: none;
    }
    :root[data-theme='light'] #themeToggle .icon-sun {
      display: none;
    }
    :root[data-theme='light'] #themeToggle .icon-moon {
      display: block;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 22px;
      height: 16px;
      background: none;
      border: none;
      cursor: pointer;
    }
    .hamburger span {
      display: block;
      height: 2px;
      width: 100%;
      background: var(--text-dark);
    }

    .site-footer {
      background: var(--surface-alt);
      border-top: 1px solid var(--border-colors);
      color: var(--text-nav);
      margin-top: 0;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3.5rem 1.5rem 2rem;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2rem;
    }
    .footer-col h4 {
      color: var(--text-nav);
      font-size: 0.99rem;
      font-weight: 700;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .footer-col a {
      display: block;
      font-size: 0.88rem;
      color: var(--text-nav);
      margin-bottom: 0.65rem;
      transition: color 0.15s ease;
    }
    .footer-col a:hover {
      color: var(--brand-purple);
    }
    .footer-brand .logo-img {
      margin-bottom: 0.85rem;
      filter: none;
    }
    :root[data-theme='light'] .footer-brand .logo-img {
      filter: none;
    }
    .footer-tagline {
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }
    .social-icons {
      display: flex;
      gap: 0.75rem;
    }
    .social-icons a {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--border-colors);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-nav);
      transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .social-icons svg {
      width: 16px;
      height: 16px;
    }
    .social-icons a:hover {
      color: var(--brand-purple);
      border-color: var(--brand-purple);
      transform: translateY(-2px);
    }

    .footer-bottom {
      border-top: 1px solid var(--border-colors);
      text-align: center;
      padding: 1.25rem 1.5rem;
      font-size: 0.8rem;
    }

    @media (max-width: 900px) {
      .footer-inner {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .main-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--surface);
        flex-direction: column;
        padding: 1rem 1.5rem;
        display: none;
        border-bottom: 1px solid var(--border-color);
      }
      .main-nav.open {
        display: flex;
      }
      .hamburger {
        display: flex;
      }
      .footer-inner {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>